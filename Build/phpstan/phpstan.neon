includes:
  - phpstan-baseline.neon

parameters:
  # Use local .cache dir instead of /tmp
  tmpDir: ../../.cache/phpstan

  level: 6

  bootstrapFiles:
    - phpstan-constants.php

  paths:
    - ../../

  excludePaths:
    # we do not check build scripts
    - ../../Build/*
    # ext_emconf.php get the $_EXTKEY set from outside. We'll ignore all of them
    - ../../ext_emconf.php
