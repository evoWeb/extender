{
	"name": "evoweb/extender",
	"type": "typo3-cms-extension",
	"description": "Extending extbase domain models like a pro with extender",
	"homepage": "https://www.evoweb.de",
	"license": [
		"GPL-2.0-or-later"
	],
	"keywords": [
		"TYPO3",
		"extbase",
		"extending",
		"domain models"
	],
	"support" : {
		"source" : "https://github.com/evoWeb/extender",
		"issues" : "https://github.com/evoWeb/extender/issues",
		"docs": "https://docs.typo3.org/p/evoweb/extender/main/en-us/"
	},
	"config": {
		"vendor-dir": "Build/vendor",
		"bin-dir": "bin",
		"allow-plugins": {
			"typo3/class-alias-loader": true,
			"typo3/cms-composer-installers": true
		}
	},
	"require": {
		"typo3/cms-core": "^13.0 || ^14.0 || 14.*.*@dev || dev-main",
		"composer/pcre": "^2.1.3",
		"nikic/php-parser": "^5.3",
		"psr/container": "^2.0",
		"psr/event-dispatcher": "^1.0",
		"symfony/cache-contracts": "^2.5.3",
		"symfony/console": "^7.3",
		"symfony/dependency-injection": "^7.3",
		"symfony/event-dispatcher-contracts": "^3.4.2"
	},
	"require-dev": {
		"friendsofphp/php-cs-fixer": "^3.88.2",
		"phpstan/phpdoc-parser": "^1.30.0",
		"phpstan/phpstan": "^2.1.32",
		"phpunit/phpunit": "^11.5.33",
		"typo3/testing-framework": "^9.2.1 || dev-main",
		"evowebtests/base-extension": "*",
		"evowebtests/extending-extension": "*",
		"typo3/cms-extensionmanager": "^13.0 || ^14.0 || 14.*.*@dev || dev-main"
	},
	"minimum-stability": "dev",
	"prefer-stable": true,
	"extra": {
		"typo3/cms": {
			"extension-key": "extender",
			"app-dir": "Build",
			"web-dir": "Build/Web"
		}
	},
	"scripts": {
		"prepare-release": [
			"rm -rf .github",
			"rm -rf Build",
			"rm -rf Tests",
			"rm .gitattributes",
			"rm .gitignore",
			"sed -i \"s/version' => '.*'/version' => '$(echo ${GITHUB_REF} | cut -d / -f 3)'/\" ext_emconf.php\n"
		],
		"post-install-cmd": [
			"ln -sf vendor/typo3/testing-framework/Resources/Core/Build/ Build/phpunit;"
		],
		"post-update-cmd": [
			"@post-install-cmd"
		],
		"post-autoload-dump": [
			"TYPO3\\TestingFramework\\Composer\\ExtensionTestEnvironment::prepare"
		]
	},
	"autoload": {
		"psr-4": {
			"Evoweb\\Extender\\": "Classes/"
		}
	},
	"autoload-dev": {
		"psr-4": {
			"Evoweb\\Extender\\Tests\\": "Tests/"
		}
	},
	"repositories": {
		"files": {
			"type": "path",
			"url": "./Tests/Fixtures/Extensions/*"
		}
	}
}
